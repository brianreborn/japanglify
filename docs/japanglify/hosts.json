{
  "schemaVersion": 2,
  "note": "Static reservations + wildcard pools. Most specific match wins. Empty match is id-only (not a catch-all). No secrets. Unknown does not auto-register.",
  "source": "brianreborn/japanglify/docs/japanglify/hosts.json",
  "unknown": {
    "role": null,
    "never": ["git.push-agent-branch", "gradle.assemble-tester", "adb.install", "secret.*"]
  },
  "leases": [
    {
      "id": "win11-pixel",
      "role": "swarm-bench",
      "os": "windows",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "Named reservation. Hostname SHALOM (runner SHALOM-swarm-bench). Beats the windows pool.",
      "match": { "hostname": ["SHALOM"] },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "unix-pixel",
      "role": "swarm-bench",
      "os": "unix",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "Named reservation for a specific Unix bench.",
      "match": { "hostname": [] },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "pool-bench-windows",
      "role": "swarm-bench",
      "os": "windows",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "DHCP pool: any Windows box with a Pixel on adb.",
      "match": { "osFamily": "windows", "adbAttached": true },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "pool-bench-unix",
      "role": "swarm-bench",
      "os": "unix",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "DHCP pool: any Unix box with a Pixel on adb.",
      "match": { "osFamily": "unix", "adbAttached": true },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "github-actions",
      "role": "watchdog",
      "os": "linux",
      "device": null,
      "notes": "GitHub-hosted. Not a laptop pool.",
      "match": { "os": "linux", "hostname": ["fv-az*", "runner-*"] },
      "never": ["gradle.*", "adb.*", "secret.keystore-release", "secret.gh-electrobrian"]
    },
    {
      "id": "grok-cloud",
      "role": "swarm-conductor",
      "os": "cloud",
      "device": null,
      "notes": "Pin only (--id grok-cloud). Do not wildcard onto workstations.",
      "match": {},
      "never": ["gradle.*", "adb.*", "secret.*", "git.push-agent-branch"]
    }
  ]
}
