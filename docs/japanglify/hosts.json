{
  "schemaVersion": 4,
  "note": "Static reservations + wildcard pools. Most specific match wins. Empty match is id-only (not a catch-all). No secrets. Unknown does not auto-register. Workdirs: {home}/swarm-agents/{project}/{hostname}/{role}/{official|dev}.",
  "source": "brianreborn/japanglify/docs/japanglify/hosts.json",
  "workdir": {
    "layout": "{home}/swarm-agents/{project}/{hostname}/{role}",
    "agentsDir": "swarm-agents",
    "clones": { "official": "official", "dev": "dev" },
    "home": { "windows": "USERPROFILE", "unix": "HOME" },
    "runner": {
      "windows": "C:\\actions-runner",
      "unix": "{home}/actions-runner",
      "github-actions": "GITHUB_WORKSPACE",
      "grok-cloud": null
    },
    "override": "SWARM_AGENTS replaces {home}/swarm-agents"
  },
  "unknown": {
    "role": null,
    "never": ["git.push-agent-branch", "gradle.assemble-tester", "adb.install", "secret.*"]
  },
  "leases": [
    {
      "id": "win11-pixel",
      "role": "swarm-bench",
      "os": "windows",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "Named reservation. Hostname SHALOM (runner SHALOM-swarm-bench). Beats the windows pool. Paths from workdir template (swarm_paths.py).",
      "match": { "hostname": ["SHALOM"] },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "unix-pixel",
      "role": "swarm-bench",
      "os": "unix",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "Named reservation for a specific Unix bench. Same {home}/src/{owner}/{repo} layout.",
      "match": { "hostname": [] },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "pool-bench-windows",
      "role": "swarm-bench",
      "os": "windows",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "DHCP pool: any Windows box with a Pixel on adb. Same path layout as win11-pixel.",
      "match": { "osFamily": "windows", "adbAttached": true },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "pool-bench-unix",
      "role": "swarm-bench",
      "os": "unix",
      "device": "adb",
      "devRepo": "electrobrian/japanglify",
      "branch": "BETA-2",
      "notes": "DHCP pool: any Unix box with a Pixel on adb. Same path layout as unix-pixel.",
      "match": { "osFamily": "unix", "adbAttached": true },
      "never": ["gradle.assemble-release", "secret.keystore-release", "ci.remote-assemble"]
    },
    {
      "id": "github-actions",
      "role": "watchdog",
      "os": "linux",
      "device": null,
      "notes": "GitHub-hosted. Not a laptop pool. Workdir is GITHUB_WORKSPACE.",
      "match": { "os": "linux", "hostname": ["fv-az*", "runner-*"] },
      "never": ["gradle.*", "adb.*", "secret.keystore-release", "secret.gh-electrobrian"]
    },
    {
      "id": "grok-cloud",
      "role": "swarm-conductor",
      "os": "cloud",
      "device": null,
      "notes": "Pin only (--id grok-cloud). Do not wildcard onto workstations. No local workdir.",
      "match": {},
      "never": ["gradle.*", "adb.*", "secret.*", "git.push-agent-branch"]
    }
  ]
}
