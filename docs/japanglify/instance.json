{
  "project": "japanglify",
  "extends": "docs/swarm-conductor/roles.json",
  "trustedActor": "brianreborn",
  "officialRepo": "brianreborn/japanglify",
  "devRepo": "electrobrian/japanglify",
  "devIntegrationBranch": "BETA-2",
  "profiles": ["android-app", "japanese-nlp"],
  "hosts": {
    "swarm-conductor": ["grok-cloud"],
    "watchdog": ["github-actions"],
    "swarm-bench": ["win11-pixel"],
    "swarm-benchRule": "One live runner to start: win11-pixel (Grok CLI + Actions listener, same logon session, Pixel on USB). Classify, fix, and /uat all run there. Do not assemble on GitHub-hosted runners. Pools in hosts.json are dormant until a second machine exists."
  },
  "commands": [
    {"cmd": "/accept", "who": "owner", "does": "Accept the bug (intake)"},
    {"cmd": "/block", "who": "owner", "does": "Block / stop"},
    {"cmd": "/uat", "who": "owner", "does": "Install on the Pixel (Swarm Bench)"},
    {"cmd": "/clip-shrink", "who": "owner", "does": "Offer compact transcode unless the clip is already small"},
    {"cmd": "/clip-ok", "who": "owner or reporter", "does": "Splice compact clip into the original comment"}
  ],
  "uat": {
    "command": "/uat",
    "applicationId": "com.japanglify.app",
    "issues": {
      "5": {
        "devRepo": "electrobrian/japanglify",
        "branch": "agent/5-chip-persistence",
        "pull": 8
      },
      "7": {
        "devRepo": "electrobrian/japanglify",
        "branch": "agent/electrobrian-9-proper-names",
        "pull": 12
      }
    }
  },
  "capabilityOverlay": {
    "swarm-bench": [
      "gradle.assemble-tester",
      "adb.install",
      "adb.tap",
      "adb.logcat",
      "secret.gh-electrobrian"
    ],
    "ci-tester": ["gradle.assemble-tester"],
    "official-signer": ["gradle.assemble-release", "secret.keystore-release"],
    "synthesizer": ["secret.gh-electrobrian"],
    "reproducerOptional": ["adb.logcat"],
    "neverOnConductor": [
      "gradle.assemble-tester",
      "gradle.assemble-release",
      "adb.install",
      "adb.tap",
      "secret.gh-electrobrian",
      "secret.keystore-release"
    ],
    "neverOnBench": [
      "gradle.assemble-release",
      "secret.keystore-release",
      "ci.remote-assemble"
    ]
  },
  "domain": {
    "language": "ja",
    "linguisticsDoc": "docs/GLOSSARY.md",
    "rules": [
      "Product linguistics (furigana, romaji, gloss, mora, Kuromoji) are not Swarm Conductor.",
      "Proper nouns: prefer tokenizer POS 名詞,固有名詞; do not add a names dictionary unless coverage is measured.",
      "Domain tests stay offline and deterministic.",
      "PROCESS_TEXT / copy-assist UAT is Pixel-side Swarm Bench, not a conductor cap."
    ]
  },
  "quotas": {
    "agentsLivePerIssue": 4,
    "openPrsPerIssue": 1,
    "prLifetimePerIssue": 3,
    "testerReleasesPerPr": 5,
    "grandfatherOpenPrs": [4, 8, 10, 11, 12]
  }
}
