<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_clipboard">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="clipboard_assist"
            app:summary="@string/pref_clipboard_assist_summary"
            app:title="@string/pref_clipboard_assist" />
        <Preference
            app:key="open_accessibility"
            app:summary="@string/pref_open_accessibility_summary"
            app:title="@string/pref_open_accessibility" />
        <Preference
            app:key="a11y_status"
            app:selectable="false"
            app:summary="@string/a11y_status_unknown"
            app:title="@string/pref_a11y_status" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:dependency="clipboard_assist"
            app:key="clipboard_fgs_fallback"
            app:summary="@string/pref_clipboard_fgs_summary"
            app:title="@string/pref_clipboard_fgs" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_scripts">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="include_furigana"
            app:summary="@string/pref_include_furigana_summary"
            app:title="@string/pref_include_furigana" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="include_romaji"
            app:summary="@string/pref_include_romaji_summary"
            app:title="@string/pref_include_romaji" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="furigana_kanji_only"
            app:summary="@string/pref_furigana_kanji_only_summary"
            app:title="@string/pref_furigana_kanji_only" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="capitalize_romaji"
            app:summary="@string/pref_capitalize_romaji_summary"
            app:title="@string/pref_capitalize_romaji" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_phonetics">
        <ListPreference
            app:defaultValue="hepburn_modified"
            app:key="romanization_system"
            app:title="@string/pref_romanization"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="below"
            app:key="romaji_position"
            app:title="@string/pref_romaji_position"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_rendering">
        <ListPreference
            app:defaultValue="interlinear"
            app:key="output_format"
            app:title="@string/pref_output_format"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="14"
            app:key="max_line_width_fullwidth"
            app:title="@string/pref_max_line_width"
            app:summary="@string/pref_max_line_width_summary"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="horizontal"
            app:key="writing_orientation"
            app:summary="@string/pref_writing_orientation_summary"
            app:title="@string/pref_writing_orientation" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_help">
        <Preference
            app:key="process_text_help"
            app:selectable="false"
            app:summary="@string/pref_process_text_help_summary"
            app:title="@string/pref_process_text_help" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_about">
        <Preference
            app:key="about"
            app:selectable="false"
            app:summary="@string/pref_about_summary"
            app:title="@string/app_name" />
    </PreferenceCategory>
</PreferenceScreen>
