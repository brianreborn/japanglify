<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/jp_surface"
    app:cardElevation="2dp"
    app:strokeColor="@color/jp_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/dictionary_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jp_ink"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dictionary_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dictionary_action_download"
            app:backgroundTint="@color/jp_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dictionary_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dictionary_action_cancel"
            android:textColor="@color/jp_red"
            app:strokeColor="@color/jp_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dictionary_delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dictionary_action_delete"
            android:textColor="@color/jp_red"
            app:strokeColor="@color/jp_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
