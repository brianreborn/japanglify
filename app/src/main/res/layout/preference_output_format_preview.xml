<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    app:cardBackgroundColor="@color/jp_surface"
    app:cardElevation="0dp"
    app:strokeColor="@color/jp_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/output_format_preview_heading"
            android:textColor="@color/jp_ink_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- One block per OutputFormat entry: label (bold when selected) + sample. -->
        <LinearLayout
            android:id="@+id/output_format_row_furigana_inline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/output_format_label_furigana_inline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jp_ink"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/output_format_sample_furigana_inline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/jp_ink"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/output_format_row_parenthetical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/output_format_label_parenthetical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jp_ink"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/output_format_sample_parenthetical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/jp_ink"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/output_format_row_interlinear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/output_format_label_interlinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jp_ink"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/output_format_sample_interlinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/jp_ink"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/output_format_row_html_ruby"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/output_format_label_html_ruby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jp_ink"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/output_format_sample_html_ruby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/jp_ink"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/output_format_row_compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/output_format_label_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jp_ink"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/output_format_sample_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/jp_ink"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
