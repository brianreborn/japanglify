# Copy to keystore.properties (git-ignored) and fill in your own values to
# enable signed release builds (./gradlew :app:assembleRelease). Without this
# file, release builds still succeed but produce an unsigned,
# not-directly-installable APK.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.keystore.jks -alias japanglify \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep both this file and the keystore safe — losing either means future
# release builds can no longer upgrade-install over an existing one.
storeFile=release.keystore.jks
storePassword=changeme
keyAlias=japanglify
keyPassword=changeme
